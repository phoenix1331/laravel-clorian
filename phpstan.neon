includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: max
    paths:
        - src
        - config
        - database
        # Fixtures use the HasWeighings trait, so Larastan analyses it.
        - tests/Fixtures
    # Larastan only allows env() in these directories.
    configDirectories:
        - config
    tmpDir: build/phpstan
